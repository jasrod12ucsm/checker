{
  "name": "@centinela/panel",
  "private": true,
  "type": "module",
  "description": "Panel web de Centinela C++ (React + Vite)",
  "scripts": {
    "dev": "vite",
    "tipos": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "tsc -p tsconfig.json && NODE_ENV=test vitest run",
    "cobertura": "NODE_ENV=test vitest run --coverage"
  },
  "dependencies": {
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "26.1.0",
    "vite": "7.3.7"
  }
}
