# Copiar a sistema/.env y completar. No subir sistema/.env al repositorio.
# Token de GitHub (fine-grained) con permisos sobre los repositorios a revisar:
#   Pull requests: Read and write · Commit statuses: Read and write · Contents: Read-only
CENTINELA_GITHUB_TOKEN=
# URL con la que GitHub y el navegador llegan al sistema (para el webhook y los enlaces).
CENTINELA_URL_PUBLICA=http://localhost:8080
# true si se sirve detrás de HTTPS.
CENTINELA_COOKIE_SEGURA=false
