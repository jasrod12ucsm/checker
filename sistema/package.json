{
  "name": "centinela",
  "private": true,
  "type": "module",
  "description": "Centinela C++: revisor automático de pull requests con el checker ucsm.ContainerInvalidation",
  "workspaces": [
    "paquetes/kernel",
    "paquetes/contextos/*",
    "paquetes/producto",
    "paquetes/adaptadores/*",
    "paquetes/app"
  ],
  "scripts": {
    "tipos": "tsc -p tsconfig.json",
    "test": "npm run tipos && vitest run",
    "cobertura": "vitest run --coverage",
    "start": "tsx paquetes/app/src/principal.ts",
    "demo": "tsx demo/demostrar.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "3.2.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "@types/better-sqlite3": "7.6.13"
  }
}
