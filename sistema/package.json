{
  "name": "centinela",
  "private": true,
  "type": "module",
  "description": "Centinela C++: revisor automático de pull requests con el checker ucsm.ContainerInvalidation",
  "workspaces": [
    "paquetes/kernel",
    "paquetes/contextos/*",
    "paquetes/producto",
    "paquetes/adaptadores/*",
    "paquetes/app",
    "frontend"
  ],
  "scripts": {
    "tipos": "tsc -p tsconfig.json",
    "test": "npm run tipos && vitest run && npm test -w @centinela/panel",
    "cobertura": "vitest run --coverage",
    "start": "tsx paquetes/app/src/principal.ts",
    "demo": "tsx demo/demostrar.ts",
    "panel": "npm run build -w @centinela/panel"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/autocannon": "7.12.7",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "3.2.7",
    "autocannon": "8.0.0",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
