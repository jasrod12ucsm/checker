skinparam ClassBorderColor #34495E
skinparam ClassHeaderBackgroundColor #EAF0F7
skinparam StateBackgroundColor #F2F6FA
skinparam StateBorderColor #34495E
skinparam NoteBackgroundColor #FFFBEA
skinparam NoteBorderColor #C9B458
skinparam ComponentBorderColor #34495E
skinparam ComponentBackgroundColor #F2F6FA
skinparam PackageBorderColor #34495E
skinparam NodeBorderColor #34495E
skinparam RectangleBorderColor #34495E
