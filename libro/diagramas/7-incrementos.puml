@startuml
!include _estilo.iuml
title Incrementos: el motor (I0 a I6) y el servicio Centinela C++ (I7)
start
partition "Motor de análisis" {
  :I0 Entorno Docker y plugin vacío registrado;
  :I1 Norma (matriz.json) + núcleo + leyes;
  fork
    :I2 Referencias y punteros desde *it, c[i], front();
    :I3 Iteradores propios, posiciones y erase de rango;
    :I4 Crédito de reserve, PolicyMode y escape;
    :I5 Notas de ruta y mensajes;
  fork again
    :Arnés: ejecutar → normalizar →\ncotejar → agregar (SARIF);
  end fork
  :I6 Banco sellado (banco-1), experimento final\ny código real (781 unidades);
}
partition "Servicio Centinela C++" {
  :I7 Registro, sesiones y roles (RF-S01);
  :I7 Repositorios y webhook firmado (RF-S02);
  :I7 Trabajador: clang + plugin, comentarios\ny estado del commit (RF-S03);
  :I7 Consultar y clasificar hallazgos (RF-S04, RF-S05);
  :I7 Mockups del panel web;
  #EEEEEE:I7 Panel web (por programar);
}
stop
@enduml
