@startuml
!include _estilo.iuml
left to right direction

actor "Administrador" as adm
actor "Desarrollador" as dev
actor "GitHub\n<<sistema externo>>" as gh
adm --|> dev

rectangle "Centinela C++ (servicio web)" {
  usecase "CU-S01\nRegistrarse e\niniciar sesión" as cu1
  usecase "CU-S02\nAprobar y gestionar\nusuarios" as cu2
  usecase "CU-S03\nConectar y configurar\nun repositorio" as cu3
  usecase "CU-S04\nRevisar un pull request\nautomáticamente" as cu4
  usecase "CU-S05\nSolicitar o reintentar\nuna revisión" as cu5
  usecase "CU-S06\nConsultar revisiones\ny hallazgos" as cu6
  usecase "CU-S07\nClasificar un hallazgo" as cu7
  usecase "Analizar el código con\nclang + ucsm.ContainerInvalidation" as an
}

dev --> cu1
dev --> cu5
dev --> cu6
dev --> cu7
adm --> cu2
adm --> cu3
gh --> cu4

cu4 ..> an : <<include>>
cu5 ..> cu4 : <<include>>
cu7 ..> cu6 : <<extend>>
@enduml
