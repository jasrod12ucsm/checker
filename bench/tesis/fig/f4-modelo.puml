rectangle "**3. Usar**\n*it, ++it, r, *p\nválido: nada · no resuelto: según política · inválido: aviso confirmado" as U
rectangle "**Evaluación**\nmisma matriz: etiquetas UB, SAFE, POLICY del banco" as E #EDF7EE
N --> O : tabla generada
O --> M : en cada camino
M --> U
N -[#7F8C8D,dashed]right-> E
