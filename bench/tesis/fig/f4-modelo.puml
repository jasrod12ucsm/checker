@startuml
!include ../../../libro/diagramas/_estilo.iuml
skinparam rectangleBackgroundColor #FFFFFF
top to bottom direction
rectangle "**Norma como datos**\nregla = (contenedor, operación, punto) × clase × relación\nefecto = preserva | invalida | depende" as N #EAF0F7
rectangle "**1. Obtener**\nbegin, find, *it, c[i], front, back, data\nhandle = (contenedor, clase, posición, válido)" as O
