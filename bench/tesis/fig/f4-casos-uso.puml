@startuml
!include ../../../libro/diagramas/_estilo.iuml
left to right direction
actor "Desarrollador\nde C++" as dev
actor "Evaluador" as eva
actor "Mantenedor" as man
rectangle "Analizador con el checker" {
  usecase "CU-01\nAnalizar un archivo" as cu1
  usecase "CU-02\nAnalizar un proyecto" as cu2
  usecase "CU-03\nElegir la política" as cu3
  usecase "CU-04\nSeguir la ruta\nde un aviso" as cu4
}
rectangle "Banco y arnés" {
  usecase "CU-05\nGenerar y validar\nel banco" as cu5
  usecase "CU-06\nEjecutar el experimento" as cu6
}
rectangle "Construcción y norma" {
  usecase "CU-07\nConstruir y verificar\nel checker" as cu7
  usecase "CU-08\nCorregir o ampliar\nla norma" as cu8
}
dev --> cu1
dev --> cu2
eva --> cu5
eva --> cu6
man --> cu7
man --> cu8
cu2 .> cu1 : <<include>>
cu1 <.. cu3 : <<extend>>
cu1 <.. cu4 : <<extend>>
cu6 ..> cu1 : <<include>>
cu6 .> cu5 : <<include>>
cu8 .> cu7 : <<include>>
@enduml
